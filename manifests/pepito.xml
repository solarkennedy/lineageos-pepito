<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for the pepito (Palm PVG100) LineageOS 24.0 (Android 17) build.
  Drop into .repo/local_manifests/ of a `repo init -b lineage-24.0` tree;
  scripts/build-lineage24-remotely.sh installs it on the builder before every sync.

  STATUS: in development, no 24.0 release yet. Projects track BRANCHES
  (pepito-24 unless noted); a release will re-pin them to tags.

  ⚠️ vendor/xiaomi is PRIVATE (proprietary blobs) and fetched over SSH; a sync
  fails there without access. Everything else is public.
  ⚠️ Not in any repo: vendor/lineage-priv/ (signing keys) and
  device/xiaomi/Mi8937/security/pepitolauncher2/*.{pk8,x509.pem}. Copy them in.
-->
<manifest>
  <remote name="pepito" fetch="https://github.com/solarkennedy/" />
  <remote name="pepito-ssh" fetch="ssh://git@github.com/solarkennedy/" />

  <!-- rebased onto lineage-24.0 -->
  <project path="device/xiaomi/Mi8937" name="android_device_xiaomi_Mi8937" remote="pepito" revision="pepito-24" />
  <project path="device/xiaomi/mithorium-common" name="android_device_xiaomi_mithorium-common" remote="pepito" revision="pepito-24" />
  <project path="kernel/xiaomi/msm8937" name="android_kernel_xiaomi_msm8937" remote="pepito" revision="pepito-24" />

  <!-- AOSP-repo forks rebased onto lineage-24.0 (2026-10-06). Not carried: system/core (fs_mgr moved to system/fs/fs_mgr). -->
  <remove-project name="LineageOS/android_frameworks_base" />
  <project path="frameworks/base" name="android_frameworks_base" remote="pepito" revision="pepito-24" groups="pdk-cw-fs,pdk-fs,sysui-studio" />
  <remove-project name="LineageOS/android_frameworks_native" />
  <project path="frameworks/native" name="android_frameworks_native" remote="pepito" revision="pepito-24" groups="pdk,sysui-studio" />
  <remove-project name="LineageOS/android_frameworks_opt_telephony" />
  <project path="frameworks/opt/telephony" name="android_frameworks_opt_telephony" remote="pepito" revision="pepito-24" groups="pdk,sysui-studio" />
  <remove-project name="LineageOS/android_vendor_lineage" />
  <project path="vendor/lineage" name="android_vendor_lineage" remote="pepito" revision="pepito-24" />
  <remove-project name="LineageOS/android_lineage-sdk" />
  <project path="lineage-sdk" name="android_lineage-sdk" remote="pepito" revision="pepito-24" />
  <remove-project name="LineageOS/android_packages_apps_LineageParts" />
  <project path="packages/apps/LineageParts" name="android_packages_apps_LineageParts" remote="pepito" revision="pepito-24" />
  <remove-project name="LineageOS/android_packages_apps_Launcher3" />
  <project path="packages/apps/Launcher3" name="android_packages_apps_Launcher3" remote="pepito" revision="pepito-24" groups="pdk-fs,sysui-studio,pdk-cw-tvc" />
  <remove-project name="LineageOS/android_bootable_recovery" />
  <project path="bootable/recovery" name="android_bootable_recovery" remote="pepito" revision="pepito-24" groups="pdk" />
  <!-- "What's new" release notes from the OTA feed (24.0 port of the 23.2 feature) -->
  <remove-project name="LineageOS/android_packages_apps_Updater" />
  <project path="packages/apps/Updater" name="android_packages_apps_Updater" remote="pepito" revision="pepito-24" />
  <remove-project name="LineageOS/android_hardware_interfaces" />
  <project path="hardware/interfaces" name="android_hardware_interfaces" remote="pepito" revision="pepito-24" groups="pdk,sysui-studio" />
  <remove-project name="LineageOS/android_hardware_lineage_interfaces" />
  <project path="hardware/lineage/interfaces" name="android_hardware_lineage_interfaces" remote="pepito" revision="pepito-24" />
  <remove-project name="platform/system/bpfprogs" />
  <project path="system/bpfprogs" name="android_system_bpfprogs" remote="pepito" revision="pepito-24" groups="pdk" />
  <remove-project name="LineageOS/android_build" />
  <project path="build/make" name="android_build" remote="pepito" revision="pepito-24" groups="pdk,sysui-studio" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <!-- pepito_gsfid domain + its neverallow exemptions (Play-cert row); device sepolicy depends on the type -->
  <remove-project name="LineageOS/android_system_sepolicy" />
  <project path="system/sepolicy" name="android_system_sepolicy" remote="pepito" revision="pepito-24" groups="pdk" />

  <!-- recovery: f2fs linear_lookup "Failed to open" is a normal fallback on 4.19, demoted to debug -->
  <remove-project name="LineageOS/android_system_fs_fs_mgr" />
  <project path="system/fs/fs_mgr" name="android_system_fs_fs_mgr" remote="pepito" revision="pepito-24" groups="pdk" />

  <!-- upstream dropped hardware/qcom-caf/bt from 24.0; our source-built libbt-vendor (23.2 branch, unchanged) -->
  <project path="hardware/qcom-caf/bt" name="android_hardware_qcom_bt" remote="pepito" revision="pepito" />

  <!-- PRIVATE blobs (A15/A16 nightly set + pepito fixups); no 24.0 blobs exist -->
  <project path="vendor/xiaomi" name="proprietary_vendor_xiaomi" remote="pepito-ssh" revision="pepito-vendor" />

  <remote name="crdroid-gitlab" fetch="https://gitlab.com/crdroidandroid/" />
  <!-- Paranoid Sense face unlock app. 23.2 shipped crDroid 16.0; 17.0 = 16.0 + one app-only commit. -->
  <project path="packages/apps/FaceUnlock" name="android_packages_apps_FaceUnlock" remote="crdroid-gitlab" revision="17.0" />

  <!-- OpenEUICC dropped for 24.0 (Mi8937 pepito-24 6c1fb8f1). -->
  <project path="packages/apps/PepitoLauncher2" name="PepitoLauncher2" remote="pepito" revision="master" />

  <!-- Upstream devicesettings pin dropped: mithorium-common pepito-24 855c9b7 carries the doze strings. -->
</manifest>
