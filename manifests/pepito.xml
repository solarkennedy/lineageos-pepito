<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for the pepito (Palm PVG100) LineageOS 23.2 build.
  Drop into .repo/local_manifests/ before `repo sync`.

  STATUS: RELEASE r1 (tag pepito-23.2-r1, 2026-07-22).

  Every project below is pinned to the immutable tag `pepito-23.2-r1` rather
  than to a branch, so a `repo sync` reproduces exactly the tree this release
  was built from. Branch names are recorded in comments for anyone who wants to
  follow ongoing work instead.

  ⚠️ TWO PROJECTS ARE PRIVATE (vendor/xiaomi, PepitoLauncher2). A `repo sync`
  with this manifest will FAIL for anyone without access to them:
    - vendor/xiaomi holds Xiaomi/Palm proprietary blobs. The reproducible public
      path is to regenerate it with device/xiaomi/Mi8937/extract-files.py from a
      documented stock/nightly source; the blob edits are scripted (the
      DT_NEEDED libqmi_force_ipcr.so fixups), not hand-hacked.
    - PepitoLauncher2 is the Palm-style launcher. Make it public, or drop the
      project and TARGET_EXCLUDES it, for a fully public build.
-->
<manifest>
  <remote name="pepito" fetch="https://github.com/solarkennedy/" revision="pepito-23.2-r1" />

  <!-- ── Device / kernel (not in the LineageOS default manifest) ──────────── -->
  <!-- working branch: pepito-rmnet -->
  <project path="device/xiaomi/Mi8937" name="android_device_xiaomi_Mi8937" remote="pepito" revision="pepito-23.2-r1" />
  <project path="device/xiaomi/mithorium-common" name="android_device_xiaomi_mithorium-common" remote="pepito" revision="pepito-23.2-r1" />
  <project path="kernel/xiaomi/msm8937" name="android_kernel_xiaomi_msm8937" remote="pepito" revision="pepito-23.2-r1" />

  <!-- ── Overrides for projects that ship in the LineageOS default manifest ── -->
  <!-- working branch: lineage23-pepito -->
  <remove-project name="LineageOS/android_bootable_recovery" />
  <project path="bootable/recovery" name="android_bootable_recovery" remote="pepito" revision="pepito-23.2-r1" />

  <!-- working branch: pepito-qs-volume-slider
       Carries: Paranoid Sense face provider (+ BiometricScheduler null-retriever
       guard), Compose QS volume slider, TaskbarManagerImpl.isTaskbarEnabled()
       patch (load-bearing with the vendor/lineage aconfig flag below). -->
  <remove-project name="LineageOS/android_frameworks_base" />
  <project path="frameworks/base" name="android_frameworks_base" remote="pepito" revision="pepito-23.2-r1" />

  <!-- working branch: pepito-qs-volume-slider -->
  <remove-project name="LineageOS/android_lineage-sdk" />
  <project path="lineage-sdk" name="android_lineage-sdk" remote="pepito" revision="pepito-23.2-r1" />

  <!-- working branch: pepito-lineageparts -->
  <remove-project name="LineageOS/android_packages_apps_LineageParts" />
  <project path="packages/apps/LineageParts" name="android_packages_apps_LineageParts" remote="pepito" revision="pepito-23.2-r1" />

  <!-- working branch: pepito -->
  <remove-project name="LineageOS/android_hardware_interfaces" />
  <project path="hardware/interfaces" name="android_hardware_interfaces" remote="pepito" revision="pepito-23.2-r1" />

  <!-- working branch: pepito — libbt-vendor Pronto/SMD on 4.19 + controller
       BDADDR NVM write (VS 0xFC0B tag 2) at USERIAL_OPEN. -->
  <remove-project name="LineageOS/android_hardware_qcom_bt" />
  <project path="hardware/qcom-caf/bt" name="android_hardware_qcom_bt" remote="pepito" revision="pepito-23.2-r1" />

  <!-- working branch: pepito — single commit (f2fs recovery log silencing). -->
  <remove-project name="LineageOS/android_system_core" />
  <project path="system/core" name="android_system_core" remote="pepito" revision="pepito-23.2-r1" />

  <!-- working branch: pepito — aconfig flag disabling enable_taskbar_on_phones
       for bp4a. Load-bearing: without it 3-button nav mis-insets over app
       buttons; the frameworks/base patch alone crash-loops Trebuchet. -->
  <remove-project name="LineageOS/android_vendor_lineage" />
  <project path="vendor/lineage" name="android_vendor_lineage" remote="pepito" revision="pepito-23.2-r1" />

  <!-- ── Private projects (see the warning in the header) ──────────────────── -->
  <!-- working branch: pepito-vendor -->
  <project path="vendor/xiaomi" name="proprietary_vendor_xiaomi" remote="pepito" revision="pepito-23.2-r1" />
  <!-- working branch: master -->
  <project path="packages/apps/PepitoLauncher2" name="PepitoLauncher2" remote="pepito" revision="pepito-23.2-r1" />
</manifest>
