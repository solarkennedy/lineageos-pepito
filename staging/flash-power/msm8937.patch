diff --git a/techpack/camera-legacy/sensor/flash/msm_flash.c b/techpack/camera-legacy/sensor/flash/msm_flash.c
index 17ae2b57b481..e567fc500200 100644
--- a/techpack/camera-legacy/sensor/flash/msm_flash.c
+++ b/techpack/camera-legacy/sensor/flash/msm_flash.c
@@ -624,6 +624,21 @@ static int32_t msm_flash_low(
 	return 0;
 }
 
+/*
+ * User-selectable cap on the main-strobe current, in mA (0 = no cap, the DT
+ * qcom,current / requested value applies as before).  Exposed as
+ * /sys/module/msm_flash/parameters/flash_cap_ma and written by
+ * init.gotweaks.rc from persist.gotweak.flash_ma ("Flash power" in PVG100
+ * System Tweaks).  Why: on a worn cell the 1 A strobe plus system load sags
+ * VPH below the PMI8950's 3.0 V droop threshold and the PMIC silently drops
+ * the LED to its 200 mA clamp (PLAN-misc.md §9 addendum 6); a lower strobe
+ * stays above the threshold.  Torch / preflash (msm_flash_low) are untouched.
+ */
+static uint flash_cap_ma;
+module_param(flash_cap_ma, uint, 0644);
+MODULE_PARM_DESC(flash_cap_ma,
+	"cap on the main flash current in mA (0 = device-tree default)");
+
 static int32_t msm_flash_high(
 	struct msm_flash_ctrl_t *flash_ctrl,
 	struct msm_flash_cfg_data_t *flash_data)
@@ -650,6 +665,11 @@ static int32_t msm_flash_high(
 				pr_debug("LED flash_current[%d] clamped %d\n",
 					i, curr);
 			}
+			if (flash_cap_ma && curr > (int32_t)flash_cap_ma) {
+				pr_debug("LED flash_current[%d] %d capped to %u\n",
+					i, curr, flash_cap_ma);
+				curr = flash_cap_ma;
+			}
 			CDBG("high_flash_current[%d] = %d", i, curr);
 			led_trigger_event(flash_ctrl->flash_trigger[i],
 				curr);
